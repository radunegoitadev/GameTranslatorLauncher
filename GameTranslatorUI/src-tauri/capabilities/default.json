{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-minimize",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{
        "name": "bin/GameTranslatorLogic",
        "sidecar": true
      }]
    }
  ]
}