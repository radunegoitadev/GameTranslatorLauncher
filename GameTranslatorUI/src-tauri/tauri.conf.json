{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GameTranslator",
  "version": "0.1.0",
  "identifier": "com.gametranslator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GameTranslator",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "bin/GameTranslatorLogic"
    ],
    "resources": [
      "appsettings.json"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNjk1MTZCQ0M0NDEzQjMKUldTekUwVE1hMUZwM0ZQMGNycmNETFl2bytYSE1FSDRBMSt6aGhBdTBZM3BPM2ZQTmNZSjFDNFUK",
      "endpoints": [
        "https://raw.githubusercontent.com/radunegoitadev/GameTranslatorLauncher/refs/heads/main/GameTranslatorUI/update.json"
      ]
    }
  }
}